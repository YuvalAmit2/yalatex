  "repository": { "type": "git", "url": "https://github.com/YuvalAmit2/yalatex" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "extensionDependencies": ["James-Yu.latex-workshop"],
  "activationEvents": ["onLanguage:latex"],
  "main": "./extension.js"
}
