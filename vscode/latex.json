// cspell:disable
{
	// yalatex snippets for VS Code (LaTeX files).
	// Type the prefix and press Enter or Tab. Prefixes are all caps so they
	// don't pop up while you write ordinary words.
	// `yalatex vscode-link-snippets` makes VS Code use this file directly, so
	// snippets added with "Snippets: Configure Snippets" -> latex are saved here.
	//
	// $1, $2 are tab stops (Tab moves to the next), $0 is where the cursor
	// ends up, ${1:$TM_SELECTED_TEXT} wraps the selected text.

	// ----- Text and math -----
	"Partial Derivative": {
		"prefix": "PD",
		"body": "\\partder[$3]{${1:$TM_SELECTED_TEXT}}{$2}$0",
		"description": "\\partder[order]{function}{variable}"
	},
	"Matrix": {
		"prefix": "MATR",
		"body": "\\matr{ ${1:$TM_SELECTED_TEXT} }$0",
		"description": "\\matr{ … } (pmatrix)"
	},
	"Italic text": {
		"prefix": "TIT",
		"body": "\\textit{${1:$TM_SELECTED_TEXT}}$0",
		"description": "\\textit{…}"
	},
	"Bold text": {
		"prefix": "TBF",
		"body": "\\textbf{${1:$TM_SELECTED_TEXT}}$0",
		"description": "\\textbf{…}"
	},
	"Implies": {
		"prefix": "IMP",
		"body": "($\\implies$) $0",
		"description": "($\\implies$)"
	},
	"Implied by": {
		"prefix": "IMB",
		"body": "($\\impliedby$) $0",
		"description": "($\\impliedby$)"
	},
	"Term": {
		"prefix": "TERM",
		"body": "\\term[$3]{${1:$TM_SELECTED_TEXT}}$2",
		"description": "\\term[]{}"
	},
	"Display math": {
		"prefix": "EQ",
		"body": ["\\begin{align*}", "${1:$TM_SELECTED_TEXT}", "\\end{align*}$0"],
		"description": "\\begin{align*}…\\end{align*}"
	},
	"Frac": {
		"prefix": "FRAC",
		"body": ["\\frac{${1:$TM_SELECTED_TEXT}}{$2}$0"],
		"description": "\\frac{}{}"
	},
	"Parenthesis": {
		"prefix": "PAREN",
		"body": ["\\paren{${1:$TM_SELECTED_TEXT}}$0"],
		"description": "\\paren{}"
	},
	"Curly brackets": {
		"prefix": "BRAX",
		"body": ["\\brax{${1:$TM_SELECTED_TEXT}}$0"],
		"description": "\\brax{}"
	},

	// ----- Theorem-like environments -----
	"Theorem": {
		"prefix": "THM",
		"body": ["\\begin{thm}", "${1:$TM_SELECTED_TEXT}", "\\end{thm}$0"],
		"description": "\\begin{thm}…\\end{thm}"
	},
	"Proposition": {
		"prefix": "PROP",
		"body": ["\\begin{prop}", "${1:$TM_SELECTED_TEXT}", "\\end{prop}$0"],
		"description": "\\begin{prop}…\\end{prop}"
	},
	"Lemma": {
		"prefix": "LEM",
		"body": ["\\begin{lem}", "${1:$TM_SELECTED_TEXT}", "\\end{lem}$0"],
		"description": "\\begin{lem}…\\end{lem}"
	},
	"Corollary": {
		"prefix": "COR",
		"body": ["\\begin{cor}", "${1:$TM_SELECTED_TEXT}", "\\end{cor}$0"],
		"description": "\\begin{cor}…\\end{cor}"
	},
	"Conjecture": {
		"prefix": "CONJ",
		"body": ["\\begin{conj}", "${1:$TM_SELECTED_TEXT}", "\\end{conj}$0"],
		"description": "\\begin{conj}…\\end{conj}"
	},
	"Definition": {
		"prefix": "DEFN",
		"body": ["\\begin{defn}", "${1:$TM_SELECTED_TEXT}", "\\end{defn}$0"],
		"description": "\\begin{defn}…\\end{defn}"
	},
	"Example": {
		"prefix": "EX",
		"body": ["\\begin{ex}", "${1:$TM_SELECTED_TEXT}", "\\end{ex}$0"],
		"description": "\\begin{ex}…\\end{ex}"
	},
	"Remark": {
		"prefix": "RMK",
		"body": ["\\begin{rmk}", "${1:$TM_SELECTED_TEXT}", "\\end{rmk}$0"],
		"description": "\\begin{rmk}…\\end{rmk}"
	},
	"Claim": {
		"prefix": "CLM",
		"body": ["\\begin{claim}", "${1:$TM_SELECTED_TEXT}", "\\end{claim}$0"],
		"description": "\\begin{claim}…\\end{claim}"
	},
	"Question": {
		"prefix": "QUE",
		"body": ["\\begin{que}", "${1:$TM_SELECTED_TEXT}", "\\end{que}$0"],
		"description": "\\begin{que}…\\end{que}"
	},
	"Exercise": {
		"prefix": "EXER",
		"body": ["\\begin{exercise}[$1]", "${2:$TM_SELECTED_TEXT}", "\\end{exercise}$0"],
		"description": "\\begin{exercise}…\\end{exercise}"
	},
	"Note box": {
		"prefix": "NTBX",
		"body": ["\\begin{notebox}", "${1:$TM_SELECTED_TEXT}", "\\end{notebox}$0"],
		"description": "\\begin{notebox}…\\end{notebox} (notes mode)"
	},
	"Note (unboxed)": {
		"prefix": "NTTH",
		"body": ["\\begin{notethm}", "${1:$TM_SELECTED_TEXT}", "\\end{notethm}$0"],
		"description": "\\begin{notethm}…\\end{notethm} (notes/homework; paper mode calls it note)"
	},
	"Proof": {
		"prefix": "PRF",
		"body": ["\\begin{proof}", "${1:$TM_SELECTED_TEXT}", "\\end{proof}$0"],
		"description": "\\begin{proof}…\\end{proof}"
	},
	"Solution": {
		"prefix": "SLT",
		"body": ["\\begin{solution}", "${1:$TM_SELECTED_TEXT}", "\\end{solution}$0"],
		"description": "\\begin{solution}…\\end{solution}"
	},
	"Exeritem": {
		"prefix": "EXERITEM",
		"body": ["\\begin{exeritem}[($1)]", "${2:$TM_SELECTED_TEXT}", "\\end{exeritem}$0"],
		"description": "\\begin{exeritem}[]…\\end{exeritem}"
	},

	// ----- Beamer -----
	"Frame": {
		"prefix": "FRM",
		"body": ["\\begin{frame}{$1}", "${2:$TM_SELECTED_TEXT}", "\\end{frame}$0"],
		"description": "\\begin{frame}{}…\\end{frame}"
	},

	"Block": {
		"prefix": "BLO",
		"body": ["\\begin{block}{$1}", "${2:$TM_SELECTED_TEXT}", "\\end{block}$0"],
		"description": "\\begin{block}{}…\\end{block}"
	},
}