#!/usr/bin/env bash
# yanew -- start a new yalatex document in the current directory.
#
#   yanew <kind> <name> ["Title"]
#
# <kind> is any mode with a starter file, i.e. starters/starter-<kind>.tex
# (currently notes, paper, beamer, homework). "hw" also means homework.
#
# Creates ./<name>/<name>.tex from starters/starter-<kind>.tex, plus an empty
# ./<name>/graphics/ folder, and opens the .tex file in VS Code.
# The title defaults to <name>.
#
# newnotes, newpaper, newbeamer and newhw are shortcuts for the four kinds.

set -euo pipefail

# The template folder is the parent of this script's folder (yalatex/bin/..).
# Set YALATEX_DIR to override.
yalatex_dir=${YALATEX_DIR:-"$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"}

# Kinds = the <kind> part of every starters/starter-<kind>.tex
available_kinds() {
  local f kinds=""
  for f in "$yalatex_dir"/starters/starter-*.tex; do
    [[ -e "$f" ]] || continue
    f=${f##*/starter-}
    kinds+="${kinds:+, }${f%.tex}"
  done
  echo "${kinds:-none found in $yalatex_dir/starters}"
}

usage() {
  echo "usage: yanew <kind> <name> [\"Title\"]   (kinds: $(available_kinds))" >&2
  exit 1
}

[[ $# -ge 2 && $# -le 3 ]] || usage
kind=$1
name=$2
title=${3:-$2}

if [[ "$kind" == hw ]]; then
  kind=homework
fi
if [[ ! "$kind" =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "yanew: unknown kind '$kind'; available: $(available_kinds)" >&2
  exit 1
fi

# Letters, digits, '-', '_' and '.' only: spaces and other characters in a
# LaTeX file name cause trouble later.
if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "yanew: '$name' is not a good file name; use letters, digits, - _ . only (no spaces)" >&2
  exit 1
fi

starter="$yalatex_dir/starters/starter-$kind.tex"
if [[ ! -f "$starter" ]]; then
  echo "yanew: unknown kind '$kind' (no starters/starter-$kind.tex); available: $(available_kinds)" >&2
  exit 1
fi

if [[ -e "$name" ]]; then
  echo "yanew: '$name' already exists here; nothing was created" >&2
  exit 1
fi

mkdir -p "$name/graphics"
file="$name/$name.tex"

# Put the title into the first \title{...Title} on the \title line. The title
# goes in through the environment so backslashes and & arrive untouched.
YA_TITLE="$title" awk '
  !done && /\\title/ && (i = index($0, "{Title}")) {
    $0 = substr($0, 1, i) ENVIRON["YA_TITLE"] substr($0, i + 6)
    done = 1
  }
  { print }
' "$starter" > "$file"

echo "Created $file"

# Open the file in VS Code. On a Mac, `open -b` hands the file to the VS Code
# that's already running. The `code` command would instead briefly start a
# second copy of VS Code, which leaves an extra VS Code icon in the Dock.
# `code` is only used as a fallback (e.g. not on a Mac).
if open -b com.microsoft.VSCode "$file" 2>/dev/null; then
  :
elif command -v code >/dev/null 2>&1; then
  code "$file"
fi
