% ya-base.sty -- packages and settings shared by every mode
% (Formerly preamble.tex in Overleaf-Template.)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ya-base}[2026/09/29 yalatex: packages and settings shared by every mode]

% Packages: Not sure what most of these do
\RequirePackage{amsmath,amsthm,amsfonts,amssymb,mathrsfs,dsfont,faktor,tikz,float,subcaption,quiver,enumerate,mathtools,booktabs,lipsum,xparse,graphicx,epstopdf,comment,indentfirst,bm,yhmath,thm-restate,fancyvrb}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage[utf8]{inputenc}
\RequirePackage[most]{tcolorbox}
\RequirePackage[boxsize=13pt,centertableaux]{ytableau}
\RequirePackage[
  backend=biber,
  style=alphabetic,
  sorting=nyt
]{biblatex}
\RequirePackage[shortlabels]{enumitem}
% \setlist{itemsep=2pt}

% Something something TikZ
\graphicspath{{graphics/}}  
\usetikzlibrary{arrows,trees,positioning}

% Code
\RequirePackage{listings}
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.97,0.97,0.97}
\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},   
    commentstyle=\color{codegray},
    keywordstyle=\color{blue},
    numberstyle=\tiny\color{codegray},
    % stringstyle=\color{codepurple},
    basicstyle=\ttfamily,
    breakatwhitespace=true,         
    breaklines=true,                 
    numbers=left,                    
    numbersep=5pt,                  
}
\lstset{style=mystyle}

\allowdisplaybreaks % break equations between pages

\endinput
