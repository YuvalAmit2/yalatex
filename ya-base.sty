% Inkscape figures (inkscape-figures, PDF+LaTeX export).
%   \incfig{name}         graphics/name.pdf_tex at the size drawn in Inkscape
%   \incfig[width]{name}  scaled to width; labels keep the document font size
\RequirePackage{import}
\NewDocumentCommand{\incfig}{O{} m}{%
  \if\relax\detokenize{#1}\relax\else\def\svgwidth{#1}\fi
  \IfFileExists{graphics/#2/#2.pdf_tex}%
    {\import{./graphics/#2/}{#2.pdf_tex}}%
    {\import{./graphics/}{#2.pdf_tex}}}

% TikZ Editor figures: \tikzfig{name}, \tikzfig[width]{name} (graphics/name.tikz).
% tikzfig.sty comes with TikZ Editor; it is loaded only if it is installed.
\IfFileExists{tikzfig.sty}{\RequirePackage{tikzfig}}{}

% Code
\RequirePackage{listings}
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.97,0.97,0.97}
\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},   
    commentstyle=\color{codegray},
    keywordstyle=\color{blue},
    numberstyle=\tiny\color{codegray},
    % stringstyle=\color{codepurple},
    basicstyle=\ttfamily,
    breakatwhitespace=true,         
    breaklines=true,                 
    numbers=left,                    
    numbersep=5pt,                  
}
\lstset{style=mystyle}

% align/align*: use the short display skips exactly when TeX would for \[ \],
% i.e. when the line before the display ends left of where the alignment starts.
\RequirePackage{etoolbox}
\newif\ifya@short
\patchcmd\align@{\tabskip\eqnshift@}{\tabskip\eqnshift@
  \ifdim\predisplaysize<\dimexpr\displayindent+\eqnshift@\relax
    \ya@shorttrue\belowdisplayskip\belowdisplayshortskip
  \else\ya@shortfalse\fi}{}{\PackageError{ya-base}{align patch failed}{}}
\patchcmd\align@{\span\align@preamble\crcr}{\span\align@preamble\crcr
  \ifya@short\noalign{\vskip-\abovedisplayskip\vskip\abovedisplayshortskip}\fi}
  {}{\PackageError{ya-base}{align patch failed}{}}
% align*: a line gets a number exactly when it has a \label.
\newif\ifya@lblnum
\def\ya@lblflag{\ifya@lblnum\global\@eqnswtrue\fi}
\patchcmd\align@{\ifst@rred\else\global\@eqnswtrue\fi\measure@}
  {\ifst@rred \ya@lblnumtrue\st@rredfalse\global\@eqnswfalse
     \def\label{\ya@lblflag\label@in@display}%
   \else \ya@lblnumfalse\global\@eqnswtrue \fi\measure@}
  {}{\PackageError{ya-base}{align patch failed}{}}
\patchcmd\math@cr@@@align{\ifst@rred\else\global\@eqnswtrue\fi}
  {\ifya@lblnum\global\@eqnswfalse\else\ifst@rred\else\global\@eqnswtrue\fi\fi}
  {}{\PackageError{ya-base}{align patch failed}{}}
\patchcmd\math@cr@@@align@measure{\ifst@rred\else\global\@eqnswtrue\fi}
  {\ifya@lblnum\global\@eqnswfalse\else\ifst@rred\else\global\@eqnswtrue\fi\fi}
  {}{\PackageError{ya-base}{align patch failed}{}}
% The measuring pass gobbles \label; let it see labeled lines too (so their
% numbers get room). cleveref replaces \measure@ when it loads, hence the delay.
\AtBeginDocument{%
  \patchcmd\measure@{\let\label\cref@gobble@optarg}
    {\def\label{\ya@lblflag\cref@gobble@optarg}}{}
    {\patchcmd\measure@{\let\label\@gobble}{\def\label{\ya@lblflag\@gobble}}
      {}{\PackageError{ya-base}{align patch failed}{}}}}

