% ya-paper.sty -- page layout and fonts for paper mode
% (Formerly paper_settings/paper_stuff.tex in Overleaf-Template.)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ya-paper}[2026/09/29 yalatex: page layout and fonts for paper mode]

% References
\RequirePackage{hyperref}
\RequirePackage[nameinlink]{cleveref}
\hypersetup{colorlinks=true,linkcolor=blue, citecolor=blue}

% Font and Spacing
\RequirePackage{mathpazo} % Font
\renewcommand{\baselinestretch}{1.23} % Line spacing
\addtolength{\jot}{4pt} % Spacing in math
\RequirePackage[skip=2pt plus2pt minus1pt]{parskip}

% Page dimensions
\RequirePackage[paperheight=11in,
   paperwidth=8.5in,
   top=10mm,
   bottom=20mm,
   left=26mm,
   right=26mm]{geometry}
\pagestyle{plain}
\endinput
